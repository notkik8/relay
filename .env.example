# Скопируйте в .env для запуска через Docker Compose.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
RELAY_HTTP_PORT=8080

# Включите оба флага для локальной демонстрации без доступа к каталогам.
CATALOG_DEMO=false
TMDB_DEMO=false
SEED_DEMO=false

# Ключ API или токен чтения TMDB.
TMDB_API_KEY=

# Задайте домен и включите защищённые cookie для профиля HTTPS.
RELAY_DOMAIN=localhost
SECURE_COOKIES=false
